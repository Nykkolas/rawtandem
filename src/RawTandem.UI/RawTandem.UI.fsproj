<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- WinExe : pas de fenêtre console allouée par Windows au lancement de
         l'exe publié (l'app est une GUI) — sans effet sous Linux. Avec Exe,
         un double-clic ouvrait une console noire à côté de la fenêtre
         (reproduit dans la recette Windows du 2026-10-30). -->
    <OutputType>WinExe</OutputType>
    <UseAvalonia>true</UseAvalonia>
    <AvaloniaUseCompactAssembly>false</AvaloniaUseCompactAssembly>
    <!-- Icône de l'exe (Windows) ; la fenêtre charge Assets/icon.png au
         runtime (barre des tâches sous Linux), voir MainWindow. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
    <PackageReference Include="Avalonia.FuncUI" Version="2.0.0" />
    <PackageReference Include="Avalonia.FuncUI.Elmish" Version="2.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Elmish" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="State.fs" />
    <Compile Include="Main.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Le harnais des scénarios attache la vraie subscription clavier
       (Main.keyboardSubscriptions, internal) à une fenêtre headless. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RawTandem.ScenarioTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RawTandem.Core\RawTandem.Core.fsproj" />
  </ItemGroup>

</Project>
