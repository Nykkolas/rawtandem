<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Les projets de tests gardent leur [<EntryPoint>] Expecto ; on désactive
         le main généré par Microsoft.NET.Test.Sdk (conflit FS0433 sinon). -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="FolderScanTests.fs" />
    <Compile Include="OrganizationTests.fs" />
    <Compile Include="DeletionTests.fs" />
    <Compile Include="ExifTests.fs" />
    <Compile Include="NavigationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RawTandem.Core\RawTandem.Core.fsproj" />
  </ItemGroup>

</Project>
